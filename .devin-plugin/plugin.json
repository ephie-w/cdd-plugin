{
  "name": "cdd-marketplace",
  "version": "0.1.0",
  "description": "Meta-plugin for AI Engineering CDD discovery: installs core and baseline plugins and advertises optional component assessments.",
  "author": { "name": "AI Engineering CDD Team" },
  "license": "MIT",
  "keywords": ["CDD", "capability discovery", "marketplace", "governance"],

  "requiredPlugins": [
    {
      "source": "git-subdir",
      "url": "https://github.com/CognitionAI/team-marketplace-template.git",
      "path": "plugins/engineering-baseline"
    },
    {
      "source": "git-subdir",
      "url": "https://github.com/CognitionAI/team-marketplace-template.git",
      "path": "plugins/security-guardrails"
    },
    {
      "source": "git-subdir",
      "url": "https://github.com/ephie-w/cdd-plugin.git",
      "path": "plugins/cdd-core",
      "ref": "codex/cdd-marketplace-import"
    },
    {
      "source": "git-subdir",
      "url": "https://github.com/ephie-w/cdd-plugin.git",
      "path": "plugins/cdd-metadata-enrichment",
      "ref": "codex/cdd-marketplace-import"
    }
  ],

  "optionalPlugins": [
    {
      "source": "git-subdir",
      "url": "https://github.com/CognitionAI/team-marketplace-template.git",
      "path": "plugins/frontend-standards"
    },
    {
      "source": "git-subdir",
      "url": "https://github.com/CognitionAI/team-marketplace-template.git",
      "path": "plugins/docs-and-release"
    },
    {
      "source": "git-subdir",
      "url": "https://github.com/anthropics/claude-code.git",
      "path": "plugins/frontend-design"
    },
    {
      "source": "git-subdir",
      "url": "https://github.com/ephie-w/cdd-plugin.git",
      "path": "plugins/cdd-braintrust-otel",
      "ref": "codex/cdd-marketplace-import"
    }
  ],

  "forbiddenPlugins": [
    "example-org/deprecated-legacy-tools",
    "untrusted-vendor/*"
  ]
}
